# API Base URL for SmartFix Backend REST API
# Default '/api' routes to the built-in Express server on port 3000.
# For an external backend server, set to e.g. http://localhost:5000/api
VITE_API_BASE_URL=/api

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
